# General App Config
DEBUG=True
SECRET_KEY=django-insecure-staymatch-super-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,nginx,core-api

# Database Config
POSTGRES_DB=staymatch_db
POSTGRES_USER=staymatch_user
POSTGRES_PASSWORD=staymatch_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Service URLs
SEARCH_SERVICE_URL=http://search-service:8001
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8002
CORE_API_URL=http://core-api:8000

# Email Config (Mock / SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_HOST_USER=mock_user
EMAIL_HOST_PASSWORD=mock_password
DEFAULT_FROM_EMAIL=notifications@staymatch.com
