# General App Config
DEBUG=True
SECRET_KEY=django-insecure-staymatch-super-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,nginx,core-api

# Supabase Auth & Project Config
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Database Config (Local Postgres or Supabase DB)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Service URLs
SEARCH_SERVICE_URL=http://search-service:8001
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8002
CORE_API_URL=http://core-api:8000

# Email Config (Mock / SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_HOST_USER=mock_user
EMAIL_HOST_PASSWORD=mock_password
DEFAULT_FROM_EMAIL=notifications@staymatch.com

# Search service (vector index)
EMBEDDING_BACKEND=sentence-transformers
INDEX_REFRESH_INTERVAL_SECONDS=60
# Leave empty to disable POST /index/refresh; set a long random value to enable it
SEARCH_ADMIN_TOKEN=

# OAuth sign-in verification (Supabase). Set at least one so Google sign-in works:
#   SUPABASE_URL        -> verifies tokens signed with the project's public keys
#   SUPABASE_JWT_SECRET -> verifies HS256 tokens (legacy projects)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=
# Local development only: lets the typed-email demo form sign in. Ignored when DEBUG is off, and it
# never signs in to an account that has a password.
ALLOW_INSECURE_DEMO_OAUTH=False

# Chat (search-service) verifies the core-api access tokens with SECRET_KEY, so both services must share it.
# CORS_ALLOWED_ORIGINS lists the frontend origins allowed to open chat WebSockets (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis requires a password (development has a built-in default; production refuses to start without one).
REDIS_PASSWORD=change-me-redis-password
# Production only: host names served, and the directory holding fullchain.pem and privkey.pem for nginx.
ALLOWED_HOSTS=staymatch.example.com
TLS_CERT_DIR=./certs
# In production set CORS_ALLOWED_ORIGINS above to your https origin, e.g. https://staymatch.example.com

# Notification emails (production requires SMTP; without SMTP_HOST development only logs them).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@staymatch.com
